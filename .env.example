# Copy to .env for local development. Never commit a filled-in .env.
ENV=development
DEMO_MODE=true

# 32-byte keys, base64url. Generate with: python scripts/gen_keys.py
VB_ENCRYPTION_KEY=
VB_ENCRYPTION_KEY_ID=k1
VB_REFERENCE_HMAC_KEY=

# One shared secret per channel (F4). Never reuse across channels.
VB_CHANNEL_SECRET_WEB=
VB_CHANNEL_SECRET_PHONE=
VB_CHANNEL_SECRET_TESTER=

# F12 — signs the browser's room token. Not a channel secret: it authorizes one
# browser to join one room for one minute, and the browser never sees any other.
VB_ROOM_TOKEN_KEY=

# F13 — the secret Vapi signs its webhooks with. Set in the Vapi dashboard; this
# side only ever verifies with it. Separate from VB_CHANNEL_SECRET_PHONE, which
# is the agent proving itself to the API rather than Vapi proving itself to the
# agent. Not a 32-byte key — whatever string Vapi is configured with.
VB_VAPI_WEBHOOK_SECRET=

VB_DATABASE_PATH=data/voicebook.db
VB_CLINIC_TIMEZONE=Asia/Karachi

# F10 — where an emergency is routed. Deployment fact, not a code fact.
VB_EMERGENCY_SERVICE_NAME=Rescue 1122
VB_EMERGENCY_NUMBER=1122

# F8 — abuse budgets. All limits are configuration; these are the defaults.
ABUSE_WINDOW_HOURS=24
MAX_SESSIONS_PER_IP_PER_DAY=3
MAX_SESSIONS_PER_CALL_ID_PER_DAY=3
MAX_BOOKINGS_PER_NAME_PER_DAY=3
MAX_BOOKINGS_PER_DAY_GLOBAL=200
MAX_REFERENCE_ATTEMPTS=5
REFERENCE_LOCK_MINUTES=60

# F12 — the browser's room token, and its own budget. The mint endpoint is the
# one unauthenticated POST in the system; the budget is what stops it being a
# free token generator.
ROOM_TOKEN_TTL_SECONDS=60
MAX_ROOM_TOKENS_PER_IP_PER_DAY=6

# F12 / C-18 — state-dependent VAD silence thresholds, in milliseconds. Served
# to the browser from /web/config; agent/vad.py holds the policy that picks one.
VAD_DEFAULT_SILENCE_MS=700
VAD_DIGIT_SILENCE_MS=1200

# F13 — the server half of the duration cap. Vapi enforces its own copy at the
# platform; this one exists because a cap that only lives in somebody else's
# dashboard is a cap that can be clicked off.
MAX_CALL_SECONDS=600

# Where the agent process reaches the tool API. The agent talks to it over HTTP
# with the same signature any external caller computes — never by importing it.
VB_API_URL=http://127.0.0.1:8000

# Provider credentials for the voice pipeline. Read server-side only; none of
# these ever reaches a browser (scripts/check_client_bundle.py enforces it).
DEEPGRAM_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# How many proxies sit in front of this service. 0 means the peer address is the
# client. Set this wrong and the rate limits become decorative.
VB_TRUSTED_PROXY_HOPS=0

# Vapi ADMIN credential - creates and deletes assistants, reads call records.
# Only scripts/push_vapi_assistant.py reads this, and only when you run it by
# hand. agent/env.py refuses to load it into the webhook server, which is the
# one process here that faces the internet (see agent/env.py NEVER_LOAD).
# Leave it empty and the script will prompt instead.
VAPI_PRIVATE_KEY=
